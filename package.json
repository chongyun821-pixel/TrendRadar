{
  "name": "procurement-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "무기조달사업예상 · Global Procurement Radar",
  "scripts": {
    "dev": "vite --port 62356 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && tsx server/node.ts",
    "serve": "tsx server/node.ts",
    "cf:dev": "vite build && wrangler pages dev dist --port 62356 --env-file .secrets",
    "deploy": "vite build && wrangler pages deploy dist",
    "mcp": "tsx mcp/server.ts",
    "mcp:http": "tsx mcp/server.ts --http",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "mcp:check": "node scripts/mcp-check.mjs",
    "data:countries": "node scripts/slim-countries.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "earcut": "^3.0.1",
    "hono": "^4.6.0",
    "three": "^0.170.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "playwright-core": "^1.48.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "4.86.0"
  },
  "engines": {
    "node": ">=20.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "workerd@1.20260426.1": true
  }
}
