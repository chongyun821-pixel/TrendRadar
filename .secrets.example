# 새 설치 시 .secrets로 복사합니다. 기존 .secrets는 유지하고 필요한 항목만 추가하세요.
# KEY=VALUE 형식이며 환경 변수 치환은 하지 않습니다. 키를 저장소에 커밋하지 마세요.

# API 키: 사용할 모델·조사 도구의 키만 입력합니다. CLI 로그인과는 별개입니다.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=

# 젬마·네모트론의 웹 검색·원문 수집용 Firecrawl Streamable HTTP MCP
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp

# API 모델: 주석을 해제하면 코드의 기본값을 재정의합니다.
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 로컬 CLI: 각 CLI에서 먼저 로그인합니다. 기본 웹·MCP·문서 스킬을 사용합니다.
# LOCAL_CLI=0 로 설정하면 코덱스·그록을 숨깁니다. 생략하면 설치된 CLI를 자동 탐색합니다.
# LOCAL_CLI=1
# CODEX_MODEL=gpt-6.1-sol
# CODEX_EFFORT=xhigh
# GROK_MODEL=grok-4.7
# GROK_EFFORT=xhigh
# 자동 탐색에 실패할 때만 실행 파일·런타임 경로를 지정합니다.
# CODEX_BIN=C:/path/to/codex/codex.js
# GROK_BIN=C:/path/to/grok/grok.exe
# CLI_RUNTIME_DIR=C:/path/to/private/cli-runtime

# 자유 양식 Word는 코덱스 Documents·그록 docx 스킬이 직접 작성·검증합니다.
# 렌더러 경로를 자식 CLI의 PATH에 추가합니다. Windows는 세미콜론, 그 외는 콜론으로 구분합니다.
# 사용자 로컬 TrendRadar/tools/libreoffice/program과 Codex 기본 런타임 Poppler는 자동 탐색합니다.
# CLI_DOCUMENT_TOOLS_PATH=C:/path/to/LibreOffice/program;C:/path/to/poppler/bin

# SQLite·대화 작업 자료: 기본 .local/radar.sqlite, .local/workspaces/<대화 UUID>/
# 상대경로는 프로젝트 루트 기준입니다. 앱과 MCP가 같은 경로를 사용해야 합니다.
# 운영 DB가 없을 때만 db/initial.sqlite를 복사합니다. 경로를 바꿀 때 기존 자료도 함께 옮기세요.
# RADAR_STORAGE_DIR=C:/path/to/private/radar
# RADAR_DB_PATH=C:/path/to/private/radar/radar.sqlite

# npm start / npm run serve의 Node 호스트. Vite 개발 포트는 vite.config.ts에서 설정합니다.
# HOST=127.0.0.1
# PORT=62356
