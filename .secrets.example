# 새 설치 시 .secrets로 복사합니다. 기존 .secrets는 유지하고 필요한 항목만 추가하세요.
# KEY=VALUE 형식이며 환경 변수 치환은 하지 않습니다. 키를 저장소에 커밋하지 마세요.

# Supabase API 연결 설정: 앱·MCP의 운영 DB는 Supabase PostgreSQL입니다.
# 최초 사용 전 npm run supabase -- migrate로 기존 자료를 이전·검증하세요.
# 프로젝트 Connect에서 확인한 https://<project-ref>.supabase.co 주소
SUPABASE_URL=
# Supabase API 키 입력란: Settings > API Keys의 서버용 Secret API key (sb_secret_...)
# 서버 전용 비밀키입니다. 브라우저에 전달하지 않습니다.
SUPABASE_SECRET_KEY=
# DB 연결 주소: Connect > Direct > Session pooler > URI
# [YOUR-PASSWORD]를 프로젝트 DB 비밀번호로 바꾸고, 비밀번호의 특수문자는 URL 인코딩합니다.
# 예: postgresql://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
# 비공개 파일 버킷. migrate 명령은 버킷이 없을 때만 생성합니다.
SUPABASE_STORAGE_BUCKET=trendradar-private
# PostgreSQL 전용 스키마. 기존 데이터와 분리된 빈 스키마에 최초 이전합니다.
# RADAR_PG_SCHEMA=trendradar

# API 키: 사용할 모델·조사 도구의 키만 입력합니다. CLI 로그인과는 별개입니다.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=

# 지피티·네모트론의 웹 검색·원문 수집용 Firecrawl Streamable HTTP MCP
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp

# API 모델: 주석을 해제하면 코드의 기본값을 재정의합니다.
# 지피티 기본 모델은 gpt-5.4-mini(OpenAI Responses API)입니다.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# 네모트론은 nvidia/nemotron-3-super-120b-a12b:free를 먼저 호출한다.
# 실패하면 openrouter/free가 요청에 맞는 무료 모델을 선택한다. 유료 모델로는 전환하지 않는다.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 로컬 CLI: 각 CLI에서 먼저 로그인합니다. 기본 웹·MCP·문서 스킬을 사용합니다.
# LOCAL_CLI=0 로 설정하면 코덱스·그록을 숨깁니다. 생략하면 설치된 CLI를 자동 탐색합니다.
# LOCAL_CLI=1
# CODEX_MODEL=gpt-6.1-sol
# CODEX_EFFORT=xhigh
# GROK_MODEL=grok-4.7
# GROK_EFFORT=xhigh
# 자동 탐색에 실패할 때만 실행 파일·런타임 경로를 지정합니다.
# CODEX_BIN=C:/path/to/codex/codex.js
# GROK_BIN=C:/path/to/grok/grok.exe
# CLI_RUNTIME_DIR=C:/path/to/private/cli-runtime

# 자유 양식 Word는 코덱스 Documents·그록 docx 스킬이 직접 작성·검증합니다.
# 렌더러 경로를 자식 CLI의 PATH에 추가합니다. Windows는 세미콜론, 그 외는 콜론으로 구분합니다.
# 사용자 로컬 TrendRadar/tools/libreoffice/program과 Codex 기본 런타임 Poppler는 자동 탐색합니다.
# CLI_DOCUMENT_TOOLS_PATH=C:/path/to/LibreOffice/program;C:/path/to/poppler/bin

# CLI 로컬 작업 폴더·다운로드 캐시: 기본 .local/workspaces/<대화 UUID>/
# 상대경로는 프로젝트 루트 기준입니다. 앱과 MCP가 같은 작업 폴더를 사용해야 합니다.
# RADAR_STORAGE_DIR=C:/path/to/private/radar
# SQLite는 이전 원본·백업에만 사용합니다. 아래는 migrate의 원본 경로이며 운영 DB 설정이 아닙니다.
# RADAR_DB_PATH=C:/path/to/private/radar/radar.sqlite

# npm start / npm run serve의 Node 호스트. Vite 개발 포트는 vite.config.ts에서 설정합니다.
# HOST=127.0.0.1
# PORT=62356
