{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": false, "isolatedModules": true, "types": ["node"]
  },
  "include": ["src", "shared", "server", "mcp", "tests", "scripts/*.ts", "vite.config.ts", "vitest.config.ts"]
}
